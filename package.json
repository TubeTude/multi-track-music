{
  "name": "multi-track-music",
  "productName": "Multi-Track Music",
  "version": "1.1.3",
  "description": "Multi-Track Music \u2014 synced multi-track audio/video recorder",
  "author": {
    "name": "TubeTude",
    "email": "TubeTude@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dir": "electron-builder --mac --dir",
    "build:local": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "build:linux": "electron-builder --linux deb AppImage --arm64"
  },
  "build": {
    "appId": "com.multitrackmusic.app",
    "productName": "Multi-Track Music",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.music",
      "extendInfo": {
        "NSCameraUsageDescription": "Multi-Track Music uses the camera to record video tracks.",
        "NSMicrophoneUsageDescription": "Multi-Track Music uses the microphone to record audio tracks."
      },
      "artifactName": "MultiTrackMusic-${version}-universal.dmg",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/musicmem.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MultiTrackMusic-Setup-${version}.exe"
    },
    "linux": {
      "icon": "assets/icons",
      "category": "AudioVideo",
      "synopsis": "Synced multi-track audio/video recorder",
      "description": "Multi-camera video recorder with a built-in mixing console. Capture up to 12 synchronized video + WAV tracks and export a 9:16 reel.",
      "desktop": {
        "StartupWMClass": "Multi-Track Music"
      },
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "MultiTrackMusic-${version}-${arch}.${ext}"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ]
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
